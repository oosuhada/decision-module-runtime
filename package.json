{
  "name": "@oosuhada/decision-engine",
  "private": false,
  "version": "0.1.0",
  "description": "Auditable deterministic decision graphs with validation, provenance, snapshots, and human approval.",
  "type": "module",
  "main": "./dist-lib/index.cjs",
  "module": "./dist-lib/index.js",
  "types": "./dist-lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/index.d.ts",
      "import": "./dist-lib/index.js",
      "require": "./dist-lib/index.cjs"
    }
  },
  "files": [
    "dist-lib",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oosuhada/decision-module-runtime.git"
  },
  "homepage": "https://github.com/oosuhada/decision-module-runtime#readme",
  "bugs": {
    "url": "https://github.com/oosuhada/decision-module-runtime/issues"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3103 --strictPort",
    "build": "tsc --noEmit && vite build",
    "build:package": "tsup src/index.ts --format esm,cjs --dts --out-dir dist-lib --clean",
    "typecheck": "tsc --noEmit --pretty false",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "pnpm test && pnpm test:e2e",
    "prepublishOnly": "pnpm test && pnpm build:package"
  },
  "dependencies": {
    "@xyflow/react": "^12.4.2",
    "lucide-react": "^0.468.0",
    "motion": "^11.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "fake-indexeddb": "^6.0.0",
    "globals": "^15.15.0",
    "jsdom": "^25.0.1",
    "tsup": "^8.5.1",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
